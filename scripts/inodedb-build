#!/usr/bin/env bash
# Builds the InodeDB server (`inodedb`) and CLI (`idb`, with `idb mount`) from the submodule into inodedb/target/release.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
# Cargo reads `.cargo/config.toml` from the directory it runs in, and InodeDB's sets `LIBSQLITE3_FLAGS` so SQLite
# syncs its WAL with `fdatasync`.
cd "$root/inodedb"
cargo build --release -p inodedb-server -p inodedb-cli --features inodedb-cli/mount
